{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:public",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": { "maxDuration": 30 },
    "api/fx/dof-usd.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/system/reset", "destination": "/api/auth/login?__system=reset" },
    { "source": "/api/auth/passkey/login/options", "destination": "/api/auth/login?__passkey=login-options" },
    { "source": "/api/auth/passkey/login/verify", "destination": "/api/auth/login?__passkey=login-verify" },
    { "source": "/api/auth/passkey/register/options", "destination": "/api/auth/login?__passkey=register-options" },
    { "source": "/api/auth/passkey/register/verify", "destination": "/api/auth/login?__passkey=register-verify" },
    { "source": "/api/dashboard/executive", "destination": "/api/internal-orders-handler?__forward_path=dashboard/executive" },
    { "source": "/api/internal-orders", "destination": "/api/internal-orders-handler" },
    { "source": "/api/internal-orders/(.*)", "destination": "/api/internal-orders-handler?__internal_path=$1" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/login.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://www.banxico.org.mx https://data-api.ecb.europa.eu https://api.frankfurter.dev; font-src 'self' data:; worker-src 'self' blob:" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    }
  ]
}
