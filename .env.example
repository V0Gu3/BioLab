DATABASE_URL=postgresql://probiolab:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/probiolab
BIO_PORT=8787
BIO_HOST=127.0.0.1
BIO_DB_POOL_SIZE=10
# Para Supabase, sustituye DATABASE_URL por la URI del "Connect" panel.
# Si el proveedor no usa un dominio supabase.co, agrega: PGSSL=require
# Solo para inicializar una base nueva; elimina la contraseña después de ejecutar db:bootstrap-admin.
# BIO_INITIAL_ADMIN_EMAIL=administracion@probiolab.mx
# BIO_INITIAL_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_DE_AL_MENOS_12_CARACTERES
# Recuperación local de administrador: agrega temporalmente las tres variables y elimínalas después.
# BIO_ADMIN_RESET_EMAIL=administracion@probiolab.mx
# BIO_ADMIN_RESET_PASSWORD=CAMBIA_ESTA_CLAVE_DE_AL_MENOS_12_CARACTERES
# BIO_ADMIN_RESET_CONFIRM=YES
# PGSSL=require
